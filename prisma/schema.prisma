generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENTREPRENEUR
  INVESTOR
}

enum SessionStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionGateway {
  STRIPE
  BINANCE_PAY
}

enum TransactionType {
  SUBSCRIPTION
  TICKET
  MICRO_INVESTMENT
  DONATION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(ENTREPRENEUR)
  avatarUrl     String?   @map("avatar_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  startups      Startup[]
  investments   FinancialTransaction[] @relation("InvestorTransactions")
  bookings      Booking[]
  tickets       Ticket[]

  @@map("users")
}

model Startup {
  id              String    @id @default(cuid())
  ownerId         String    @map("owner_id")
  name            String
  description     String
  sector          String
  valuationTarget Decimal   @map("valuation_target") @db.Decimal(12, 2)
  logoUrl         String?   @map("logo_url")
  isApproved      Boolean   @default(false) @map("is_approved")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  owner           User      @relation(fields: [ownerId], references: [id])
  pitchDecks      PitchDeck[]
  pitchSessions   PitchSession[]

  @@map("startups")
}

model PitchDeck {
  id               String   @id @default(cuid())
  startupId        String   @map("startup_id")
  filePath         String   @map("file_path")
  encryptionKeyId  String   @map("encryption_key_id")
  version          Int      @default(1)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  startup          Startup  @relation(fields: [startupId], references: [id])

  @@map("pitch_decks")
}

model PitchSession {
  id                   String        @id @default(cuid())
  startupId            String        @map("startup_id")
  scheduledStart       DateTime      @map("scheduled_start")
  scheduledEnd         DateTime      @map("scheduled_end")
  timerDurationSeconds Int           @default(180) @map("timer_duration_seconds")
  status               SessionStatus @default(SCHEDULED)
  dailyRoomName        String?       @map("daily_room_name")
  dailyRoomUrl         String?       @map("daily_room_url")
  calendarEventId      String?       @map("calendar_event_id")
  createdAt            DateTime      @default(now()) @map("created_at")

  startup              Startup       @relation(fields: [startupId], references: [id])
  recording            Recording?
  bookings             Booking[]

  @@map("pitch_sessions")
}

model Recording {
  id              String       @id @default(cuid())
  pitchSessionId  String       @unique @map("pitch_session_id")
  filePath        String       @map("file_path")
  durationSeconds Int?         @map("duration_seconds")
  fileSizeBytes   BigInt?      @map("file_size_bytes")
  recordedAt      DateTime     @default(now()) @map("recorded_at")

  pitchSession    PitchSession @relation(fields: [pitchSessionId], references: [id])

  @@map("recordings")
}

model Booking {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  pitchSessionId  String       @map("pitch_session_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  user            User         @relation(fields: [userId], references: [id])
  pitchSession    PitchSession @relation(fields: [pitchSessionId], references: [id])

  @@map("bookings")
}

model Ticket {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  transactionId   String?              @unique @map("transaction_id")
  eventName       String               @map("event_name")
  createdAt       DateTime             @default(now()) @map("created_at")

  user            User                 @relation(fields: [userId], references: [id])
  transaction     FinancialTransaction? @relation(fields: [transactionId], references: [id])

  @@map("tickets")
}

model FinancialTransaction {
  id                    String              @id @default(cuid())
  userId                String              @map("user_id")
  gateway               TransactionGateway
  externalTransactionId String?             @map("external_transaction_id")
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("USD")
  transactionType       TransactionType     @map("transaction_type")
  status                TransactionStatus   @default(PENDING)
  auditHash             String?             @map("audit_hash")
  metadata              Json?               // datos adicionales del pago
  createdAt             DateTime            @default(now()) @map("created_at")

  user                  User                @relation("InvestorTransactions", fields: [userId], references: [id])
  ticket                Ticket?

  @@map("financial_transactions")
}
